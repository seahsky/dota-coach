# Copy to .env (same folder) and fill in. .env is git-ignored.

# Optional. Enables STRATZ ranked per-position stats and bracket matchups.
# Get a token at https://stratz.com/api
STRATZ_API_KEY=

# Optional overrides.
# DOTACOACH_CACHE_DIR=/path/to/cache
# DOTACOACH_NO_CACHE=1
# DOTACOACH_DEBUG=1
# DOTACOACH_PROFILE=/path/to/profile.json
# Command the watcher runs after each game instead of `claude -p` (a command saved in the
# dashboard wins). Bun expands $VARS in .env values, so prefer setting it in the dashboard.
# Gets DOTACOACH_MATCH_ID,
# DOTACOACH_ACCOUNT_ID, DOTACOACH_HERO and DOTACOACH_REVIEW_FILE in its environment.
# DOTACOACH_ON_MATCH=
